global:
  env: "${env}"
  environment: "${environment}"
  buildingBlock: "${building_block}"
  cloud:
    storage:
      provider: "${cloud_storage_provider}"
      region: "${cloud_storage_region}"
      # OCI Specific Object Storage details
      namespace: "${oci_object_storage_namespace}" # OCI Object Storage requires a namespace
      publicContainerName: "${oci_storage_bucket_public}"
      privateContainerName: "${oci_storage_bucket_private}"
    kubernetes:
      # These values would come from your OKE cluster outputs
      endpoint: "${oke_cluster_endpoint}"
      clusterName: "${oke_cluster_name}"
    # OCI-specific project/compartment details
    oci:
      compartmentId: "${oci_compartment_ocid}"
      region: "${cloud_storage_region}" # Using cloud_storage_region as the main OCI region
  secrets:
    randomString: "${random_string}"
  networking:
    privateIngressGatewayIp: "${private_ingressgateway_ip}"
  storage:
    class: "${storage_class}"

  public_container_name: ${oci_public_container_name}
  private_container_name: ${oci_private_container_name}
  oci_public_container_name: ${oci_public_container_name}
  oci_private_container_name: ${oci_private_container_name}
  dial_state_container_name: ${oci_dial_state_container_public}
  private_ingressgateway_ip: ${private_ingressgateway_ip}
  random_string: ${random_string}
  storage_class: ${storage_class}
  cloud_storage_provider:  ${cloud_storage_provider}
  cloud_storage_region: ${cloud_storage_region}
  cloud_private_storage_accountname: "dummystring"
  cloud_private_storage_secret: "dummystring"
  cloud_storage_secret_key: "${random_string}"
  cloud_storage_access_key: "${random_string}"
  
  serviceAccount: 
    create: true
    name: sunbird-sa
    annotations:
      iam.oke.io/oci-service-account: "TODO"

velero:                                                       
  enabled: true
  serviceAccount:
    server:
      create: true
      name: velero-sa
      annotations:
        iam.oke.io/oci-service-account: "TODO"
  credentials:
    useSecret: false
  configuration:
    backupStorageLocation:
      - name: default
        provider: ${cloud_storage_provider}
        bucket: "${oci_public_container_name}"
        config:
          prefix: backups
          serviceAccount: "TODO"
    backupSyncPeriod: 15m
    volumeSnapshotLocation:
    - name: default
      provider: ${cloud_storage_provider}
      config:
        project: "TODO"
        region:  ${cloud_storage_region}     
  initContainers:
    - image: velero/velero-plugin-for-oci
      name: velero-plugin-for-oci
      volumeMounts:
        - mountPath: /target
          name: plugins  

spark: 
  serviceAccount:
    create: false 
    name: "sunbird-sa"            

nginx-public-ingress:
  commonAnnotations:
    reloader.stakater.com/auto: "true"
    # OCI Load Balancer Annotations for an external Load Balancer
    # These annotations are applied to the Kubernetes Service of type LoadBalancer
    service.beta.kubernetes.io/oci-load-balancer-shape: "flexible" # Or "10Mbps", "100Mbps", "400Mbps", "8000Mbps" etc.
    service.beta.kubernetes.io/oci-load-balancer-shape-min: "10" # Min bandwidth for flexible shape
    service.beta.kubernetes.io/oci-load-balancer-shape-max: "100" # Max bandwidth for flexible shape (adjust as needed)
    # Potentially for network security groups (NSGs) if you prefer over security lists:
    # service.beta.kubernetes.io/oci-load-balancer-nsg-ids: "ocid1.networksecuritygroup.oc1..<nsg_id_1>,ocid1.networksecuritygroup.oc1..<nsg_id_2>"
    
